{
  "packageId": "app.leafpage.reader",
  "host": "www.leafpage.app",
  "name": "Leafpage",
  "launcherName": "Leafpage",
  "display": "standalone",
  "themeColor": "#efe6d2",
  "themeColorDark": "#1b1712",
  "navigationColor": "#efe6d2",
  "navigationColorDark": "#1b1712",
  "navigationDividerColor": "#efe6d2",
  "navigationDividerColorDark": "#1b1712",
  "backgroundColor": "#efe6d2",
  "enableNotifications": false,
  "startUrl": "/",
  "iconUrl": "https://www.leafpage.app/icons/icon-512.png",
  "maskableIconUrl": "https://www.leafpage.app/icons/icon-maskable-512.png",
  "splashScreenFadeOutDuration": 300,
  "appVersionName": "1.0.0",
  "appVersion": "1",
  "appVersionCode": 1,
  "signingKey": {
    "path": "./upload.keystore",
    "alias": "upload"
  },
  "generatorApp": "bubblewrap-cli",
  "webManifestUrl": "https://www.leafpage.app/manifest.webmanifest",
  "fallbackType": "customtabs",
  "features": {},
  "enableSiteSettingsShortcut": false,
  "orientation": "default",
  "fingerprints": [],
  "additionalTrustedOrigins": [],
  "isChromeOSOnly": false,
  "isMetaQuest": false,
  "shortcuts": [
    {
      "name": "New note",
      "shortName": "New note",
      "url": "/?new=note",
      "chosenIconUrl": "https://www.leafpage.app/icons/icon-192.png",
      "iconUrl": "https://www.leafpage.app/icons/icon-192.png"
    },
    {
      "name": "PDF tools",
      "shortName": "PDF tools",
      "url": "/?tab=tools",
      "chosenIconUrl": "https://www.leafpage.app/icons/icon-192.png",
      "iconUrl": "https://www.leafpage.app/icons/icon-192.png"
    }
  ],
  "minSdkVersion": 24,
  "shareTarget": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "files",
          "accept": [
            "application/pdf",
            "application/epub+zip",
            ".pdf",
            ".epub"
          ]
        }
      ]
    }
  }
}
