{
  "packageId": "app.leafpage.reader",
  "host": "leafpage.app",
  "name": "Leafpage",
  "launcherName": "Leafpage",
  "display": "standalone",
  "themeColor": "#efe6d2",
  "themeColorDark": "#1b1712",
  "navigationColor": "#efe6d2",
  "navigationColorDark": "#1b1712",
  "navigationDividerColor": "#efe6d2",
  "navigationDividerColorDark": "#1b1712",
  "backgroundColor": "#efe6d2",
  "enableNotifications": false,
  "startUrl": "/",
  "iconUrl": "https://leafpage.app/icons/icon-512.png",
  "maskableIconUrl": "https://leafpage.app/icons/icon-maskable-512.png",
  "splashScreenFadeOutDuration": 300,
  "appVersionName": "1.0.0",
  "appVersion": "1",
  "appVersionCode": 1,
  "signingKey": { "path": "./upload.keystore", "alias": "upload" },
  "generatorApp": "bubblewrap-cli",
  "webManifestUrl": "https://leafpage.app/manifest.webmanifest",
  "fallbackType": "customtabs",
  "features": {},
  "enableSiteSettingsShortcut": false,
  "orientation": "default",
  "fingerprints": [],
  "additionalTrustedOrigins": ["https://www.leafpage.app"],
  "isChromeOSOnly": false,
  "isMetaQuest": false,
  "shortcuts": [
    { "name": "New note", "short_name": "New note", "url": "/?new=note", "icon": "https://leafpage.app/icons/icon-192.png" },
    { "name": "PDF tools", "short_name": "PDF tools", "url": "/?tab=tools", "icon": "https://leafpage.app/icons/icon-192.png" }
  ],
  "minSdkVersion": 23
}
