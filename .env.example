# Google OAuth client ID (type "Web application") for Google Drive sync.
# Leave unset to build without sync. See "Google Drive sync" in README.md.
VITE_GOOGLE_CLIENT_ID=

# Server side (Vercel Function api/auth.ts) for staying signed in:
# GOOGLE_CLIENT_SECRET=
# SESSION_SECRET=   # optional: openssl rand -base64 32

# Plans (see "Premium" in README.md). Limits apply only when PAYWALL_ENFORCED=1.
# PAYWALL_ENFORCED=1
# TRIAL_DAYS=7
# Where Premium is bought (build-time, shown on the paywall; leave unset until the apps are listed):
# VITE_PLAY_URL=
# VITE_APPSTORE_URL=

# Once the app is on Google Play: send browsers to it. android = only Android browsers; all = every browser.
# VITE_APP_GATE=android
